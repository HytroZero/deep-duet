{
  "name": "dsh-plugin-deepduet",
  "version": "1.0.0",
  "description": "DeepDuet multi-session collaborative coding mode for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/deepduet.patch.yml": "./presets/deepduet.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "locale/tools/*.json",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/deepduet.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:backend": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:backend && npm run build:client",
    "dev": "npm run build && node dist/preview.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-error": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.2 <0.3.0-0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-group": "~1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-agent-preset": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-web": "0.2.2-rc.3",
    "@deepseek-ai/dsh-error": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.3",
