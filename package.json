    "micromark-util-types": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.6.0",
    "simple-icons": "^16.31.0",
    "typescript": "6.0.3",
    "vite": "^6.4.3",
    "zod": "^4.6.6",
    "zustand": "~4.5.7"
  }
